/**
 * Проби розбору сторінок Мінфіну — ПЕРШІ автоматичні проби цього проєкту.
 *
 * ⚠️ НАВІЩО. До 12.09.2026 у проєкті не було жодної проби: ні `test`-скрипта в
 * package.json, ні тестового каталогу. Єдине, що стояло на сторожі цін, — межа
 * «від 5 до 500» у двох місцях. А ціна з цього коду потрапляє на сайт, у
 * Telegram, в Instagram і в мета-опис для Google: помилку побачать люди і
 * приймуть за нею рішення.
 *
 * Випадки взяті з живого перемірювання: кожен тут — беда, яку прилад
 * пропускав мовчки.
 *
 * ЗАПУСК:  node scripts/tests-parser.mjs
 */
import { parseAverages, parseNetworks, parseDetail, знайтиДату } from './lib/minfin.mjs';

let провалів = 0;

function проба(назва, вийшло, чекали) {
  const однаково = JSON.stringify(вийшло) === JSON.stringify(чекали);
  if (!однаково) провалів++;
  console.log(`  ${однаково ? '✅' : '❌'} ${назва.padEnd(58)} -> ${JSON.stringify(вийшло)}`);
  if (!однаково) console.log(`      чекали: ${JSON.stringify(чекали)}`);
}

const СЬОГОДНІ = new Date(Date.UTC(2026, 8, 12));   // 12.09.2026

console.log('ДАТА СТОРІНКИ');

// ⚠️ Головна беда: «на» збігалося всередині «ціна»/«зміна», і сьогоднішні ціни
// лягали під архівною датою, ЗАТИРАЮЧИ історичний день.
проба('архівний рядок не перебиває явне «Оновлення»',
  знайтиДату('<h2>Архів цін на 28.07.2026</h2><p>Оновлення: 12.09.2026</p>', СЬОГОДНІ),
  '12.09.2026');

проба('«Зміна 01.01.2020» не є датою сторінки',
  знайтиДату('<td>Зміна 01.01.2020</td>', СЬОГОДНІ), null);

// ⚠️ Дата тут СВІЖА навмисне: зі старою пробу рятувала б перевірка
// правдоподібності, і вона ловила б не те. Підсадка це й показала.
проба('«ціна 10.09.2026» всередині слова — не дата',
  знайтиДату('<td>середня ціна 10.09.2026</td>', СЬОГОДНІ), null);
проба('«зміна 11.09.2026» всередині слова — не дата',
  знайтиДату('<td>зміна 11.09.2026</td>', СЬОГОДНІ), null);

проба('дата з майбутнього відкидається',
  знайтиДату('Оновлення: 31.12.2099', СЬОГОДНІ), null);

проба('надто стара дата відкидається',
  знайтиДату('Оновлення: 01.01.1999', СЬОГОДНІ), null);

проба('вчорашня дата приймається',
  знайтиДату('Станом на 11.09.2026', СЬОГОДНІ), '11.09.2026');

проба('«на» окремим словом працює як запасний варіант',
  знайтиДату('<p>Ціни на 10.09.2026</p>', СЬОГОДНІ), '10.09.2026');

console.log('');
console.log('СЕРЕДНІ ЦІНИ');

const сторінка = `
  <p>Оновлення: 12.09.2026</p>
  <table>
    <tr><th>Паливо</th><th>Ціна</th><th>Зміна</th></tr>
    <tr><td>А-95 преміум</td><td>72,00</td><td>0,10</td></tr>
    <tr><td>А-95</td><td>68,00</td><td>-0,20</td></tr>
    <tr><td>ДП</td><td>60,50</td><td>0,30</td></tr>
    <tr><td>Автогаз</td><td>29,50</td><td>0,05</td></tr>
  </table>`;

const р = parseAverages(сторінка);
проба('ціна ДП зчитана', р.avg.dp, 60.5);
проба('дата сторінки зчитана', р.date, '12.09.2026');
проба('падіння ціни лишається падінням', р.change.a95, -0.2);

function падіння(назва, дія) {
  let впало = false;
  try { дія(); } catch { впало = true; }
  if (!впало) провалів++;
  console.log(`  ${впало ? '✅' : '❌'} ${назва.padEnd(58)} -> ${впало ? 'відмовився' : 'НЕ ВІДМОВИВСЯ'}`);
}

console.log('');
console.log('КОЛОНКИ ТАБЛИЦІ');

// ⚠️ Головна беда: ціни бралися як п'ять ОСТАННІХ клітинок. Зайва колонка
// «ДП+» зсувала все, і дизель публікувався по 30,00 замість 60,00 — удвічі
// дешевше, без жодної тривоги: 30 проходить перевірку «від 5 до 500».
const зДП_плюс = `<table>
  <tr><th>Мережа</th><th>А-95+</th><th>А-95</th><th>А-92</th><th>ДП</th><th>ДП+</th><th>Газ</th></tr>
  <tr><td>WOG</td><td>70,00</td><td>68,00</td><td>65,00</td><td>60,00</td><td>62,00</td><td>30,00</td></tr>
</table>`;

проба('зайва колонка «ДП+» не зсуває дизель',
  parseNetworks(зДП_плюс).WOG,
  { a95p: 70, a95: 68, a92: 65, dp: 60, gas: 30 });

проба('рядок шапки не збирається як мережа',
  Object.keys(parseNetworks(зДП_плюс)), ['WOG']);

// /tm/: між назвою і цінами стоїть клітинка з лого
const зЛого = `<table>
  <tr><th>Оператор</th><th></th><th>А-95+</th><th>А-95</th><th>А-92</th><th>ДП</th><th>Газ</th></tr>
  <tr><td>ОККО</td><td><img src="okko.png"></td><td>71,00</td><td>69,00</td><td>66,00</td><td>61,00</td><td>31,00</td></tr>
</table>`;
проба('колонка з лого не з\'їдає ціну',
  parseNetworks(зЛого).ОККО,
  { a95p: 71, a95: 69, a92: 66, dp: 61, gas: 31 });

// /reg/: лого немає
const безЛого = `<table>
  <tr><th>Область</th><th>А-95+</th><th>А-95</th><th>А-92</th><th>ДП</th><th>Газ</th></tr>
  <tr><td>Київська</td><td>72,00</td><td>70,00</td><td>67,00</td><td>62,00</td><td>32,00</td></tr>
</table>`;
проба('таблиця без лого читається так само',
  parseNetworks(безЛого).Київська,
  { a95p: 72, a95: 70, a92: 67, dp: 62, gas: 32 });

// «А-95 Premium» латиницею — премія не має йти у звичайний А-95
const латиницею = `<table>
  <tr><th>Мережа</th><th>А-95 Premium</th><th>А-95</th><th>А-92</th><th>ДП</th><th>Газ</th></tr>
  <tr><td>UPG</td><td>73,00</td><td>69,50</td><td>66,50</td><td>61,50</td><td>31,50</td></tr>
</table>`;
проба('«Premium» латиницею йде в преміум, а не в А-95',
  parseNetworks(латиницею).UPG,
  { a95p: 73, a95: 69.5, a92: 66.5, dp: 61.5, gas: 31.5 });

// ⚠️ Без шапки сім клітинок неоднозначні: [назва, лого, 5 цін] і [назва, 6 цін]
// однакові завдовжки. Тут друга клітинка — число, тобто лого немає, колонок
// більше, ніж ми знаємо. Краще чесно відмовитись, ніж опублікувати зсув.
падіння('без шапки і з зайвою колонкою — відмова, а не здогад', () =>
  parseNetworks(`<table>
    <tr><td>WOG</td><td>70,00</td><td>68,00</td><td>65,00</td><td>60,00</td><td>62,00</td><td>30,00</td></tr>
  </table>`));

// Той самий slice(-5) стояв і в parseDetail
const детально = `<table>
  <tr><th>Оператор</th><th>А-95+</th><th>А-95</th><th>А-92</th><th>ДП</th><th>ДП+</th><th>Газ</th></tr>
  <tr><td colspan="7">Київська обл.</td></tr>
  <tr><td>WOG</td><td>70,00</td><td>68,00</td><td>65,00</td><td>60,00</td><td>62,00</td><td>30,00</td></tr>
</table>`;
проба('parseDetail: «ДП+» так само не зсуває дизель',
  parseDetail(детально).regions.Київська.WOG,
  { a95p: 70, a95: 68, a92: 65, dp: 60, gas: 30 });

console.log('');
console.log(провалів ? `❌ ПРОВАЛІВ: ${провалів}` : '✅ усі проби пройшли');
process.exit(провалів ? 1 : 0);
